# Copy to .env for local runs (`python main.py`). On Fly these are secrets / [env] in fly.toml.
ANTHROPIC_API_KEY=            # LLM shadow reviewer + strategy analyst (optional)
KALSHI_KEY_ID=                # optional locally; enables the WebSocket order books + trade tape
KALSHI_PRIVATE_KEY=           # RSA PEM contents (or KALSHI_PRIVATE_KEY_PATH=./key.pem)
DASHBOARD_PASSWORD=           # HTTP basic auth; also enables dashboard controls
DATABASE_URL=sqlite+aiosqlite:///./tennis.db
SERIES=KXATPMATCH,KXWTAMATCH,KXATPCHALLENGERMATCH,KXWTACHALLENGERMATCH,KXITFMATCH,KXITFWMATCH
# Guard rails shared by all strategies (defaults)
QUIET_SEC=5
MAX_MID_MOVE_CENTS=2
MAX_SPREAD_CENTS=5
PRIOR_POINTS=120
PAPER_BANKROLL_USD=1000
LLM_MODEL=claude-opus-5-5
LLM_DAILY_BUDGET_USD=3.0
ANALYST_INTERVAL_HOURS=6
